# Rename this file to .env (or set these keys in Render / Railway Environment Variables)
# Never commit your real .env file to GitHub.

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=loop-vault

GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=LOOP Reminders <reminders@yourdomain.com>

# Comma-separated frontend URLs allowed by CORS
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
